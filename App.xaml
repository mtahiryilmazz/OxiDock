<Application x:Class="OxiDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OxiDock"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ======================================================== -->
        <!-- HYPEROS 3 & HARMONYOS 3 MASTER RESOURCE DICTIONARY       -->
        <!-- Living Glass & Continuous Geometry (Squircles & Accents) -->
        <!-- ======================================================== -->

        <!-- 1. Corner Radius Tokens (Concentric Squircle Formula) -->
        <CornerRadius x:Key="RadiusMasterDock">26</CornerRadius>
        <CornerRadius x:Key="RadiusWindowFrame">22</CornerRadius>
        <CornerRadius x:Key="RadiusDynamicIsland">20</CornerRadius>
        <CornerRadius x:Key="RadiusCardMaster">18</CornerRadius>
        <CornerRadius x:Key="RadiusCardDock">16</CornerRadius>
        <CornerRadius x:Key="RadiusSettingCard">16</CornerRadius>
        <CornerRadius x:Key="RadiusPreviewWell">11</CornerRadius>
        <CornerRadius x:Key="RadiusIconBadge">10</CornerRadius>
        <CornerRadius x:Key="RadiusStatusChip">10</CornerRadius>
        <CornerRadius x:Key="RadiusSizePill">8</CornerRadius>

        <!-- 2. Base Material Surfaces -->
        <SolidColorBrush x:Key="HyperDarkSurfaceBase" Color="#0D111A"/>
        <SolidColorBrush x:Key="HyperDarkCardBg" Color="#181E2E"/>
        <SolidColorBrush x:Key="HyperDarkCardBgTranslucent" Color="#22181E2E"/>
        <SolidColorBrush x:Key="HyperDarkCardRecessed" Color="#0A0D14"/>

        <SolidColorBrush x:Key="HyperLightSurfaceBase" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="HyperLightCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HyperLightCardBgTranslucent" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="HyperLightCardRecessed" Color="#E2E8F0"/>

        <!-- Dynamic Themed Surface Fallbacks -->
        <SolidColorBrush x:Key="HyperCardSurfaceBrush" Color="#1E162438"/>
        <SolidColorBrush x:Key="HyperCardSurfaceHoverBrush" Color="#3024344E"/>
        <SolidColorBrush x:Key="HyperCardRecessedWellBrush" Color="#D9080B12"/>

        <!-- 3. 45° Specular Directional Glass Border Brushes -->
        <LinearGradientBrush x:Key="HyperGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#60FFFFFF" Offset="0.0"/>
            <GradientStop Color="#25FFFFFF" Offset="0.45"/>
            <GradientStop Color="#0DFFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HyperGlassBorderHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B338BDF8" Offset="0.0"/>
            <GradientStop Color="#5538BDF8" Offset="0.40"/>
            <GradientStop Color="#1A38BDF8" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HyperVioletBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B3C084FC" Offset="0.0"/>
            <GradientStop Color="#558B5CF6" Offset="0.40"/>
            <GradientStop Color="#1AA855F7" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HyperLightGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A0FFFFFF" Offset="0.0"/>
            <GradientStop Color="#50CBD5E1" Offset="0.50"/>
            <GradientStop Color="#2094A3B8" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 4. Liquid Glass Card Background Gradients -->
        <LinearGradientBrush x:Key="HyperLiquidCardBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2C202B3E" Offset="0.0"/>
            <GradientStop Color="#20131B2A" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HyperLiquidCardBgHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3D2B3D58" Offset="0.0"/>
            <GradientStop Color="#2A1A263B" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HyperCardPreviewBgBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E60A0D14" Offset="0.0"/>
            <GradientStop Color="#CC07090F" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 5. Vibrant Micro-Accent Gradients (5 Functional Palettes) -->
        <!-- Electric Sky: Time, System & Action Primary -->
        <LinearGradientBrush x:Key="HyperAccentCyanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0.0"/>
            <GradientStop Color="#06B6D4" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Emerald Mint: Health, RAM, Active Status & Vitality -->
        <LinearGradientBrush x:Key="HyperAccentMintGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0.0"/>
            <GradientStop Color="#10B981" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Neon Violet: AI Assistant, Media & Creative Flow -->
        <LinearGradientBrush x:Key="HyperAccentVioletGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C084FC" Offset="0.0"/>
            <GradientStop Color="#8B5CF6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Solar Coral: Pomodoro Focus, Heat & Urgency -->
        <LinearGradientBrush x:Key="HyperAccentCoralGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FB7185" Offset="0.0"/>
            <GradientStop Color="#F97316" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Amber Gold: Finance, Crypto, Sun & Alerts -->
        <LinearGradientBrush x:Key="HyperAccentGoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FBBF24" Offset="0.0"/>
            <GradientStop Color="#F59E0B" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 6. Micro-Accent Solid Brushes -->
        <SolidColorBrush x:Key="HyperColorSky" Color="#38BDF8"/>
        <SolidColorBrush x:Key="HyperColorMint" Color="#34D399"/>
        <SolidColorBrush x:Key="HyperColorViolet" Color="#C084FC"/>
        <SolidColorBrush x:Key="HyperColorCoral" Color="#FB7185"/>
        <SolidColorBrush x:Key="HyperColorGold" Color="#FBBF24"/>

        <!-- 7. Shared Component Styles -->
        <!-- Squircle Icon Backdrop Badge -->
        <Style x:Key="HyperIconBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusIconBadge}"/>
            <Setter Property="Background" Value="#2238BDF8"/>
            <Setter Property="BorderBrush" Value="#4438BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Status Indicator Chip / Pill -->
        <Style x:Key="HyperStatusChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusStatusChip}"/>
            <Setter Property="Padding" Value="8,2.5"/>
            <Setter Property="Background" Value="#2034D399"/>
            <Setter Property="BorderBrush" Value="#4434D399"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Multi-Size Selector Pill Button -->
        <Style x:Key="HyperSizePillStyle" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{StaticResource RadiusSizePill}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#3038BDF8"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="#6638BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#5538BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recessed Optical Preview Well -->
        <Style x:Key="HyperCardPreviewWellStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HyperCardPreviewBgBrush}"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPreviewWell}"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Master HyperOS & HarmonyOS Reusable Card Container Style -->
        <Style x:Key="HyperCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HyperLiquidCardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HyperGlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCardMaster}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" 
                                      Color="#000000" Opacity="0.60" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HyperLiquidCardBgHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource HyperGlassBorderHoverBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" 
                                              Color="#38BDF8" Opacity="0.32" RenderingBias="Performance"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
