                            <StackPanel x:Name="PnlCalendar1x2" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock x:Name="TxtCal1x2Date" Text="📅 26 Ekim Pazartesi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                <TextBlock x:Name="TxtCal1x2Events" Text="Bugün: 2 Planlı Görev" FontSize="9" Foreground="#38BDF8" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- 1x3: 7 Günlük Mini Hafta Takvimi -->
                            <StackPanel x:Name="PnlCalendar1x3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="4,0">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="EKİM 2026" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="Bugün: Kodlama &amp; Plan" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                </StackPanel>
                                <Border Width="1" Height="22" Background="{DynamicResource DockMutedForegroundBrush}" Margin="2,0,6,0" Opacity="0.3"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Pzt [26] • Sal 27 • Çar 28 • Per 29 • Cum 30" FontSize="9" Foreground="{DynamicResource DockSecondaryForegroundBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 11. Hızlı Spotlight Arama Widget'ı (Yeni Web Widget!) -->
                    <Border x:Name="WidgetQuickSearch" Grid.Column="11" Style="{StaticResource WidgetContainerStyle}" ToolTip="Hızlı Web / AI Arama" Visibility="Collapsed">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt" Click="MenuWidgetSize_Click" Tag="quicksearch:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Standart Arama" Click="MenuWidgetSize_Click" Tag="quicksearch:1x2"/>
                                <MenuItem Header="📏 Boyut: 1x3 Çoklu Motor" Click="MenuWidgetSize_Click" Tag="quicksearch:1x3"/>
                                <Separator/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHideQuickSearch_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid VerticalAlignment="Center" Margin="4,0">
                            <!-- 1x1: Mini Ara Butonu -->
                            <Button x:Name="PnlSearch1x1" Style="{StaticResource DockButtonStyle}" Width="30" Height="30" Click="BtnQuickSearch1x1_Click" ToolTip="Hızlı Arama Aç" Visibility="Collapsed">
                                <TextBlock Text="🔍" FontSize="12"/>
                            </Button>

                            <!-- 1x2: İnput Kutusu (Enter ile Doğrudan Ara) -->
                            <StackPanel x:Name="PnlSearch1x2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#1C1C28" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="10" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtSearchBox" Width="90" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" 
                                                 FontSize="10" VerticalAlignment="Center" KeyDown="TxtSearchBox_KeyDown" ToolTip="Yazın ve Enter'a basın"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 1x3: Çoklu Arama Paneli -->
                            <StackPanel x:Name="PnlSearch1x3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Background="#1C1C28" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="11" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="TxtSearchBox1x3" Width="120" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" 
                                                 FontSize="11" VerticalAlignment="Center" KeyDown="TxtSearchBox_KeyDown"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Google" Style="{StaticResource DockButtonStyle}" FontSize="9" Padding="6,2" Margin="3,0,1,0" Click="BtnSearchEngine_Click" Tag="google"/>
                                <Button Content="Perplexity" Style="{StaticResource DockButtonStyle}" FontSize="9" Padding="6,2" Margin="1,0" Click="BtnSearchEngine_Click" Tag="perplexity"/>
                                <Button Content="ChatGPT" Style="{StaticResource DockButtonStyle}" FontSize="9" Padding="6,2" Margin="1,0" Click="BtnSearchEngine_Click" Tag="chatgpt"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 12. Ses Seviyesi & Çıkış Denetleyicisi (Yeni!) -->
                    <Border x:Name="WidgetVolume" Grid.Column="12" Style="{StaticResource WidgetContainerStyle}" ToolTip="Windows Ses Düzeyi" Visibility="Collapsed">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt" Click="MenuWidgetSize_Click" Tag="volume:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Slider" Click="MenuWidgetSize_Click" Tag="volume:1x2"/>
                                <Separator/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHideVolume_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid VerticalAlignment="Center" Margin="4,0">
                            <!-- 1x1: Mini Ses -->
                            <StackPanel x:Name="PnlVolume1x1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0">
                                <TextBlock Text="🔊" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TxtVolume1x1" Text="70%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 1x2: Slider'lı Ses Denetleyici -->
                            <StackPanel x:Name="PnlVolume1x2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0">
                                <Button Style="{StaticResource DockButtonStyle}" Width="26" Height="26" Click="BtnVolumeMute_Click" ToolTip="Sessize Al">
                                    <TextBlock x:Name="TxtVolIcon" Text="🔊" FontSize="11"/>
                                </Button>
                                <Slider x:Name="SldVolume" Width="60" Minimum="0" Maximum="100" Value="70" VerticalAlignment="Center" Margin="4,0,2,0" ValueChanged="SldVolume_ValueChanged"/>
                                <TextBlock x:Name="TxtVolVal" Text="70%" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource DockSecondaryForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 13. Pano Geçmişi Widget'ı (Yeni!) -->
                    <Border x:Name="WidgetClipboard" Grid.Column="13" Style="{StaticResource WidgetContainerStyle}" ToolTip="Pano Geçmişi" Visibility="Collapsed">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt" Click="MenuWidgetSize_Click" Tag="clipboard:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Standart" Click="MenuWidgetSize_Click" Tag="clipboard:1x2"/>
                                <Separator/>
                                <MenuItem Header="📋 Son Öğeyi Yapıştır" Click="BtnClipboardPaste_Click"/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHideClipboard_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                            <TextBlock Text="📋" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="TxtClipboardPreview" Text="Pano Boş" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DockForegroundBrush}" MaxWidth="70" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 14. Hızlı Not Aç/Kapat Düğmesi -->
                    <Border x:Name="WidgetNotes" Grid.Column="14" Style="{StaticResource WidgetContainerStyle}">
                        <Button Style="{StaticResource DockButtonStyle}" Background="Transparent" BorderThickness="0" 
                                Click="BtnToggleNote_Click" ToolTip="Hızlı Not Paneli" Padding="6,2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📌" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNotesLabel" Text="Not" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- 15. Ayarlar Düğmesi (Settings) -->
                    <Border Grid.Column="15" Style="{StaticResource WidgetContainerStyle}" Margin="2,0,0,0">
                        <Button Style="{StaticResource DockButtonStyle}" Background="Transparent" BorderThickness="0" 
                                Click="BtnOpenSettings_Click" ToolTip="OxiDock Ayarlar Paneli" Width="32" Height="32">
                            <TextBlock Text="⚙️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Border>

                    <!-- 16. Sağ Sürükleme Tutamacı -->
                    <Border Grid.Column="16" Width="14" Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" ToolTip="Dock'u Taşımak İçin Sürükleyin"
                            Margin="4,0,2,0" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </StackPanel>

        <!-- Hızlı Not Açılır Pop-up Penceresi -->
        <Popup x:Name="PopNote" StaysOpen="False" Placement="Top" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="#E6161620" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1.2"
                    Width="280" Height="180" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.7"/>
                </Border.Effect>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="📝 OxiDock Hızlı Notlarım" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                                Foreground="#88FFFFFF" Cursor="Hand" Click="BtnCloseNote_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtQuickNote" Grid.Row="1" Background="#20000000" Foreground="#FFFFFF"
                             BorderBrush="#1AFFFFFF" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"
                             FontSize="12" Padding="6" TextChanged="TxtQuickNote_TextChanged"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
