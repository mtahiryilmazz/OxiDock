<Window x:Class="OxiDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OxiDock"
        mc:Ignorable="d"
        Title="OxiDock v2.1" 
        SizeToContent="WidthAndHeight"
        MinWidth="200" MaxWidth="1920"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- Dinamik Tema Fırçaları (Açık ve Koyu Tema Uyumu) -->
        <SolidColorBrush x:Key="DockForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DockSecondaryForegroundBrush" Color="#AAFFFFFF"/>
        <SolidColorBrush x:Key="DockMutedForegroundBrush" Color="#88FFFFFF"/>
        <SolidColorBrush x:Key="DockWidgetBackgroundBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="DockWidgetBorderBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="DockButtonBackgroundBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="DockButtonForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DockButtonBorderBrush" Color="#22FFFFFF"/>

        <!-- Modern Buton Stili -->
        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DockButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockButtonBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profil Sekme Düğmesi Stili -->
        <Style x:Key="ProfileTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DockButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DockSecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockButtonBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Widget Konteyner Stili -->
        <Style x:Key="WidgetContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DockWidgetBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DockWidgetBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="4,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DockButtonBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DockButtonBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="DockScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <StackPanel VerticalAlignment="Bottom">
            <!-- 0. OxiDock Üst Profil Sekmeleri (Hover ile Canlı Gösterim & Sürükle-Bırak Hedefi) -->
            <Border x:Name="ProfileBarBorder" HorizontalAlignment="Center" Background="#D9121217" CornerRadius="14" 
                    BorderBrush="#25FFFFFF" BorderThickness="1" Padding="6,3" Margin="0,0,0,3" Opacity="0.92">
                <StackPanel x:Name="SpProfileTabs" Orientation="Horizontal" VerticalAlignment="Center" AllowDrop="True">
                    <!-- Dinamik oluşturulacak profiller veya varsayılanlar -->
                    <Button Style="{StaticResource ProfileTabStyle}" Content="1. Standart" Tag="default-1" Click="BtnProfileTab_Click"/>
                    <Button Style="{StaticResource ProfileTabStyle}" Content="2. İş &amp; Geliştirici" Tag="default-2" Click="BtnProfileTab_Click"/>
                    <Button Style="{StaticResource ProfileTabStyle}" Content="3. Odaklanma" Tag="default-3" Click="BtnProfileTab_Click"/>
                    <Button Style="{StaticResource ProfileTabStyle}" Content="🧩 Kütüphane" Click="BtnOpenWidgetBrowser_Click" ToolTip="Widget Kütüphanesini Aç (160+ Widget)"/>
                </StackPanel>
            </Border>

            <!-- Ana Yüzen Dock Paneli (Sürükle-Bırak Hedefi & Otomatik Boyut) -->
            <Border x:Name="MainDockBorder" HorizontalAlignment="Center" Background="#E6101016" CornerRadius="24" BorderBrush="#33FFFFFF" BorderThickness="1.2"
                    Margin="6,0,6,8" AllowDrop="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
                    Drop="MainDockBorder_Drop" DragEnter="MainDockBorder_DragEnter" 
                    DragLeave="MainDockBorder_DragLeave" DragOver="MainDockBorder_DragOver">
                <Border.Effect>
                    <DropShadowEffect x:Name="DockShadow" BlurRadius="25" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.8"/>
                </Border.Effect>

                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 0. Sol Tutamaç -->
                        <ColumnDefinition Width="Auto"/> <!-- 1. Saat & Dünya Saati -->
                        <ColumnDefinition Width="Auto"/> <!-- 2. Pomodoro & Odak -->
                        <ColumnDefinition Width="Auto"/> <!-- 3. Hava Durumu -->
                        <ColumnDefinition Width="Auto"/> <!-- 4. CPU, RAM & Donanım -->
                        <ColumnDefinition Width="Auto"/> <!-- 5. Hızlı Uygulamalar -->
                        <ColumnDefinition Width="Auto"/> <!-- 6. Özel Araç / Terminal -->
                        <ColumnDefinition Width="Auto"/> <!-- 7. Canlı Ağ & Ping -->
                        <ColumnDefinition Width="Auto"/> <!-- 8. Müzik & Medya Çalar -->
                        <ColumnDefinition Width="Auto"/> <!-- 9. Kripto & Finans (Yeni) -->
                        <ColumnDefinition Width="Auto"/> <!-- 10. Takvim & Ajanda (Yeni) -->
                        <ColumnDefinition Width="Auto"/> <!-- 11. Hızlı Spotlight Arama (Yeni) -->
                        <ColumnDefinition Width="Auto"/> <!-- 12. Ses Denetleyicisi (Yeni) -->
                        <ColumnDefinition Width="Auto"/> <!-- 13. Pano / Clipboard (Yeni) -->
                        <ColumnDefinition Width="Auto"/> <!-- 14. Hızlı Not -->
                        <ColumnDefinition Width="Auto"/> <!-- 15. Ayarlar Düğmesi -->
                        <ColumnDefinition Width="Auto"/> <!-- 16. Sağ Tutamaç -->
                    </Grid.ColumnDefinitions>

                    <!-- 0. Sol Sürükleme Tutamacı -->
                    <Border Grid.Column="0" Width="14" Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" ToolTip="Dock'u Taşımak İçin Sürükleyin"
                            Margin="2,0,4,0" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource DockMutedForegroundBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- 1. Saat Widget'ı (1x1, 1x2, 1x3 Android Boyutları) -->
                    <Border x:Name="WidgetClock" Grid.Column="1" Style="{StaticResource WidgetContainerStyle}" 
                            ToolTip="Sol Tık: Stili Değiştir | Sağ Tık: Boyut &amp; Seçenekler" Cursor="Hand" MouseLeftButtonUp="WidgetClock_Click">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt" Click="MenuWidgetSize_Click" Tag="clock:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Standart" Click="MenuWidgetSize_Click" Tag="clock:1x2"/>
                                <MenuItem Header="📏 Boyut: 1x3 Genişletilmiş" Click="MenuWidgetSize_Click" Tag="clock:1x3"/>
                                <Separator/>
                                <MenuItem Header="🕒 Dijital Saat" Click="MenuClockStyle_Click" Tag="digital"/>
                                <MenuItem Header="🎴 Retro Flip Clock" Click="MenuClockStyle_Click" Tag="flip"/>
                                <MenuItem Header="⏱️ Klasik Analog Saat" Click="MenuClockStyle_Click" Tag="analog"/>
                                <MenuItem Header="🌍 Küresel Dünya Saatleri" Click="MenuClockStyle_Click" Tag="world"/>
                                <Separator/>
                                <MenuItem Header="⏱️ Saniyeyi Aç / Kapat" Click="MenuClockToggleSeconds_Click"/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHideClock_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        
                        <Grid Margin="6,0" VerticalAlignment="Center">
                            <!-- 1x1: Kompakt Saat -->
                            <StackPanel x:Name="PnlClock1x1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0">
                                <TextBlock Text="⏰" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtClock1x1" Text="10:45" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 1x2: Standart Saat (Dijital, Flip, Analog) -->
                            <Grid x:Name="PnlClock1x2" VerticalAlignment="Center">
                                <!-- 1.A: Dijital -->
                                <StackPanel x:Name="PnlClockDigital" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtClock" Text="10:42" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" 
                                               HorizontalAlignment="Center" FontFamily="Segoe UI, Inter"/>
                                    <TextBlock x:Name="TxtDate" Text="26 Eki, Pzt" FontSize="10" Foreground="{DynamicResource DockSecondaryForegroundBrush}" 
                                               HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                                <!-- 1.B: Flip -->
                                <StackPanel x:Name="PnlClockFlip" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="#1A000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="0,0,2,0">
                                            <TextBlock x:Name="TxtFlipHours" Text="10" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" FontFamily="Segoe UI, Consolas"/>
                                        </Border>
                                        <TextBlock Text=":" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <Border Background="#1A000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="5,2">
                                            <TextBlock x:Name="TxtFlipMinutes" Text="42" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" FontFamily="Segoe UI, Consolas"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtFlipDate" Text="26 Eki • RETRO" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource DockSecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- 1.C: Analog -->
                                <StackPanel x:Name="PnlClockAnalog" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Grid Width="38" Height="38" Margin="0,0,6,0">
                                        <Ellipse Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.4" Fill="#15000000"/>
                                        <Line X1="19" Y1="3" X2="19" Y2="5" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.5"/>
                                        <Line X1="19" Y1="33" X2="19" Y2="35" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.5"/>
                                        <Line X1="3" Y1="19" X2="5" Y2="19" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.5"/>
                                        <Line X1="33" Y1="19" X2="35" Y2="19" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.5"/>
                                        <Line x:Name="AnalogHourHand" X1="19" Y1="19" X2="19" Y2="10" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Line.RenderTransform><RotateTransform x:Name="AnalogHourTransform" CenterX="19" CenterY="19" Angle="300"/></Line.RenderTransform>
                                        </Line>
                                        <Line x:Name="AnalogMinuteHand" X1="19" Y1="19" X2="19" Y2="7" Stroke="{DynamicResource DockForegroundBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                            <Line.RenderTransform><RotateTransform x:Name="AnalogMinuteTransform" CenterX="19" CenterY="19" Angle="210"/></Line.RenderTransform>
                                        </Line>
                                        <Line x:Name="AnalogSecondHand" X1="19" Y1="19" X2="19" Y2="5" Stroke="#EF4444" StrokeThickness="1" StrokeStartLineCap="Round">
                                            <Line.RenderTransform><RotateTransform x:Name="AnalogSecondTransform" CenterX="19" CenterY="19" Angle="90"/></Line.RenderTransform>
                                        </Line>
                                        <Ellipse Width="4" Height="4" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAnalogDigital" Text="10:42" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                        <TextBlock x:Name="TxtAnalogDate" Text="26 Eki" FontSize="9" Foreground="{DynamicResource DockSecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 1.D: Dünya Saatleri -->
                                <StackPanel x:Name="PnlClockWorld" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtWorldTime1" Text="IST 10:42" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                        <Border Width="1" Height="10" Background="{DynamicResource DockMutedForegroundBrush}" Margin="4,0" Opacity="0.4"/>
                                        <TextBlock x:Name="TxtWorldTime2" Text="NYC 03:42" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtWorldTime3" Text="LON 07:42 • TYO 16:42" FontSize="8" Foreground="{DynamicResource DockSecondaryForegroundBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1x3: Genişletilmiş Küresel Zaman Paneli -->
                            <StackPanel x:Name="PnlClock1x3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="4,0">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtClock1x3Big" Text="10:45:20" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                    <TextBlock x:Name="TxtClock1x3Date" Text="İstanbul (UTC+3) • 26 Ekim Pazartesi" FontSize="9" Foreground="{DynamicResource DockSecondaryForegroundBrush}"/>
                                </StackPanel>
                                <Border Width="1" Height="28" Background="{DynamicResource DockMutedForegroundBrush}" Margin="0,0,8,0" Opacity="0.3"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌍 KÜRESEL SAATLER" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtWorldTimeMulti" Text="NYC 03:45 • LON 07:45 • TYO 16:45" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DockForegroundBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Pomodoro & Odak / Sağlık (1x1, 1x2, 1x3) -->
                    <Border x:Name="WidgetPomodoro" Grid.Column="2" Style="{StaticResource WidgetContainerStyle}"
                            ToolTip="Sol Tık: Başlat/Duraklat | Sağ Tık: Boyut &amp; Menü" Cursor="Hand" MouseLeftButtonUp="WidgetPomodoro_Click">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt" Click="MenuWidgetSize_Click" Tag="pomodoro:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Standart" Click="MenuWidgetSize_Click" Tag="pomodoro:1x2"/>
                                <MenuItem Header="📏 Boyut: 1x3 Genişletilmiş" Click="MenuWidgetSize_Click" Tag="pomodoro:1x3"/>
                                <Separator/>
                                <MenuItem Header="▶ / ⏸ Başlat / Duraklat" Click="MenuPomoToggle_Click"/>
                                <MenuItem Header="⏭ Molaya / Sıradaki Tura Atla" Click="MenuPomoSkip_Click"/>
                                <MenuItem Header="↺ Sıfırla (25:00)" Click="MenuPomoReset_Click"/>
                                <Separator/>
                                <MenuItem Header="🍅 Odaklanma Modu (25 dk)" Click="MenuPomoMode_Click" Tag="focus"/>
                                <MenuItem Header="☕ Kısa Mola (5 dk)" Click="MenuPomoMode_Click" Tag="shortbreak"/>
                                <MenuItem Header="🏖️ Uzun Mola (15 dk)" Click="MenuPomoMode_Click" Tag="longbreak"/>
                                <Separator/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHidePomo_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid VerticalAlignment="Center" Margin="6,0">
                            <!-- 1x1: Kompakt Pomodoro -->
                            <StackPanel x:Name="PnlPomo1x1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0">
                                <TextBlock Text="🍅" FontSize="14" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TxtPomo1x1Timer" Text="25m" FontSize="13" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 1x2: Standart Pomodoro -->
                            <Grid x:Name="PnlPomo1x2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BdPomoEmoji" Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#26EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPomoEmoji" Text="🍅" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="TxtPomoStatus" Text="ODAK" FontSize="9" FontWeight="Bold" Foreground="#F87171" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtPomoRounds" Text="● ○ ○ ○" FontSize="8" Foreground="#38BDF8" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtPomoTimer" Text="25:00" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" Margin="0,1,0,2"/>
                                    <ProgressBar x:Name="PbPomoProgress" Value="100" Maximum="100" Height="3" Width="76" HorizontalAlignment="Left"
                                                 Foreground="#EF4444" Background="#25FFFFFF" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 1x3: Genişletilmiş Pomodoro Paneli -->
                            <StackPanel x:Name="PnlPomo1x3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="4,0">
                                <Border Width="38" Height="38" CornerRadius="19" Background="#26EF4444" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="🍅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="TxtPomo1x3Status" Text="ODAK SEANSI (Tur 1/4)" FontSize="10" FontWeight="Bold" Foreground="#F87171" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="TxtPomo1x3Rounds" Text="● ○ ○ ○" FontSize="8" Foreground="#38BDF8" DockPanel.Dock="Right" Margin="6,0,0,0"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtPomo1x3Timer" Text="25:00" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" Margin="0,1"/>
                                    <ProgressBar x:Name="PbPomo1x3Progress" Value="100" Maximum="100" Height="4" Width="100" HorizontalAlignment="Left" Foreground="#EF4444" Background="#25FFFFFF" BorderThickness="0"/>
                                </StackPanel>
                                <Border Width="1" Height="30" Background="{DynamicResource DockMutedForegroundBrush}" Margin="0,0,6,0" Opacity="0.3"/>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="25m Odak" Style="{StaticResource DockButtonStyle}" FontSize="9" Padding="6,2" Margin="0,1" Click="MenuPomoMode_Click" Tag="focus"/>
                                    <Button Content="5m Mola" Style="{StaticResource DockButtonStyle}" FontSize="9" Padding="6,2" Margin="0,1" Click="MenuPomoMode_Click" Tag="shortbreak"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Hava Durumu Widget'ı (1x1: Derece, 1x2: Standart+Yarın, 1x3: 5 Günlük Tahmin) -->
                    <Border x:Name="WidgetWeather" Grid.Column="3" Style="{StaticResource WidgetContainerStyle}"
                            ToolTip="Sol Tık: Yenile | Sağ Tık: Boyut &amp; Şehir" Cursor="Hand" MouseLeftButtonDown="WidgetWeather_MouseLeftButtonDown">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📏 Boyut: 1x1 Kompakt Derece" Click="MenuWidgetSize_Click" Tag="weather:1x1"/>
                                <MenuItem Header="📏 Boyut: 1x2 Standart + Yarın" Click="MenuWidgetSize_Click" Tag="weather:1x2"/>
                                <MenuItem Header="📏 Boyut: 1x3 5 Günlük Tahmin" Click="MenuWidgetSize_Click" Tag="weather:1x3"/>
                                <Separator/>
                                <MenuItem Header="↻ Canlı Tahmini Yenile" Click="WidgetWeather_Refresh_Click"/>
                                <MenuItem Header="✕ Widget'ı Gizle" Click="MenuHideWeather_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid VerticalAlignment="Center" Margin="8,0">
                            <!-- 1x1: Kompakt Hava Durumu -->
                            <StackPanel x:Name="PnlWeather1x1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0">
                                <TextBlock x:Name="TxtWeather1x1Icon" Text="☀️" FontSize="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtWeather1x1Temp" Text="22°" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 1x2: Standart Hava Durumu -->
                            <Grid x:Name="PnlWeather1x2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtWeatherTemp" Text="22°" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DockForegroundBrush}"/>
                                    <TextBlock x:Name="TxtWeatherCity" Text="İstanbul" FontSize="10" Foreground="{DynamicResource DockSecondaryForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border Width="1" Height="28" Background="{DynamicResource DockMutedForegroundBrush}" Margin="0,0,6,0" Opacity="0.3"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Yarın" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource DockMutedForegroundBrush}" HorizontalAlignment="Center"/>
