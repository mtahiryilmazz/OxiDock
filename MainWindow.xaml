                                    <StackPanel x:Name="SpEqualizer" Orientation="Horizontal" Margin="0,2,0,0">
                                        <Rectangle x:Name="Bar1" Width="3" Height="4" Fill="#22C55E" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0"/>
