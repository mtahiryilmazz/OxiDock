                                    <ProgressBar x:Name="PbRam" Value="46" Maximum="100" Height="3" Width="38" Margin="0,2,0,0" Foreground="#A855F7" Background="#22FFFFFF" BorderThickness="0"/>
                                </StackPanel>
                                <StackPanel x:Name="SpBattery" HorizontalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="PİL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource DockMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBatteryVal" Text="⚡ 92%" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 1x3: Genişletilmiş Tam Donanım Dashboard -->
