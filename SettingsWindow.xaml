<Window x:Class="OxiDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OxiDock Kontrol Merkezi v2.2" Height="640" Width="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <!-- Sekme Düğmesi Stili -->
        <Style x:Key="TabNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0E2E8F0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2838BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#6638BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ayar Satırı Konteyner Stili -->
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#161E2E"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Görsel Tema Önizleme Kartı Stili -->
        <Style x:Key="ThemePreviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="#F40D131F" BorderBrush="#4438BDF8" BorderThickness="1.2" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/> <!-- Sol Gezinme Menüsü -->
                <ColumnDefinition Width="*"/>   <!-- Sağ İçerik Paneli -->
            </Grid.ColumnDefinitions>

            <!-- Sol Gezinme Sidebar -->
            <Border Grid.Column="0" Background="#0A0F1A" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0" CornerRadius="20,0,0,20" Padding="16"
                    MouseLeftButtonDown="Sidebar_MouseLeftButtonDown">
                <DockPanel>
                    <!-- Üst Logo & Başlık -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,4,2,18">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#2538BDF8" BorderBrush="#6638BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="⚡" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OxiDock" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                                <Border Background="#2838BDF8" CornerRadius="5" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.2" FontSize="9.5" Foreground="#38BDF8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Living Island • Super Tile • Liquid Glass" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Alt Aksiyon Butonları -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="✨ + Yeni Özel Widget Oluştur" Height="34" Margin="0,0,0,8" Background="#2210B981" 
                                Foreground="#34D399" FontWeight="Bold" BorderThickness="1" BorderBrush="#5510B981" Cursor="Hand" Click="BtnOpenWidgetStudio_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="💾 Kaydet ve Uygula" Height="38" Background="#38BDF8" 
                                Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Menü Seçenekleri -->
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="KONTROL MERKEZİ" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="8,0,0,6"/>
                        <RadioButton x:Name="TabBtnAppearance" Style="{StaticResource TabNavButtonStyle}" Content="🎨  Görünüm &amp; Cam Temaları" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnCustomWidgets" Style="{StaticResource TabNavButtonStyle}" Content="✨  Özel Widget'larım" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnLayout" Style="{StaticResource TabNavButtonStyle}" Content="📐  Ekran Konumu &amp; Düzen" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnProfiles" Style="{StaticResource TabNavButtonStyle}" Content="🗂️  Çalışma Alanları (Profil)" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnGeneral" Style="{StaticResource TabNavButtonStyle}" Content="⚙️  Genel &amp; Hava Durumu" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnPomodoro" Style="{StaticResource TabNavButtonStyle}" Content="🍅  Pomodoro &amp; Wellness" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBtnAi" Style="{StaticResource TabNavButtonStyle}" Content="🤖  Yerel AI Asistan (MCP)" Checked="Tab_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sağ İçerik Alanı -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Üst Pencere Barı -->
                <Border Grid.Row="0" Background="#0D1524" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" CornerRadius="0,20,0,0" Padding="20,0"
                        MouseLeftButtonDown="Sidebar_MouseLeftButtonDown">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" Background="#1FFFFFFF" Foreground="#CBD5E1"
                                BorderThickness="0" Cursor="Hand" Click="BtnCloseWindow_Click" ToolTip="Kapat">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                            </Button.Resources>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2238BDF8" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="CANLI ÖNİZLEME AKTİF" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Text="Yaptığınız her tema, ölçek ve konum değişikliği arkadaki Dock üzerinde anında görünür." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,20">
                    <Grid>
                        <!-- 1. GÖRÜNÜM VE GLASS TEMALARI (VARSAYILAN AÇILIŞ SEKMESİ) -->
                        <StackPanel x:Name="PanelAppearance" Visibility="Visible">
                            <TextBlock Text="🎨 Görünüm &amp; Cam Temaları" FontSize="19" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Liquid Glass, Frosted Crystal ve Living Island esintili cam yüzeylerinden birine tıklayarak anında önizleyin." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,14"/>

                            <!-- Görsel Tema Kartları (3 Sütunlu Grid) -->
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <!-- Dark Glass -->
                                <Border x:Name="CardThemeDarkGlass" Style="{StaticResource ThemePreviewCardStyle}" Tag="DarkGlass" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#D9101016" BorderBrush="#44FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#38BDF8" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#33FFFFFF" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#10B981"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="🌙 Dark Glass" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Koyu Buzlu Kristal Cam" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Liquid Glass -->
                                <Border x:Name="CardThemeLiquidGlass" Style="{StaticResource ThemePreviewCardStyle}" Tag="LiquidGlass" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#B80C1426" BorderBrush="#38BDF8" BorderThickness="1.4" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#38BDF8" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#5538BDF8" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#06B6D4"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="🌊 Liquid Glass" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                        <TextBlock Text="Akıcı Mavi Parlak Cam" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Light Glass -->
                                <Border x:Name="CardThemeLightGlass" Style="{StaticResource ThemePreviewCardStyle}" Tag="LightGlass" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#E6F0F4F8" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#0284C7" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#330F172A" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#F97316"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="❄️ Light Glass" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Aydınlık Kuvars Yüzey" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cyberpunk Neon -->
                                <Border x:Name="CardThemeCyberpunk" Style="{StaticResource ThemePreviewCardStyle}" Tag="Cyberpunk" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#D00E081C" BorderBrush="#A855F7" BorderThickness="1.4" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#EC4899" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#55A855F7" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#8B5CF6"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="⚡ Cyberpunk Neon" FontWeight="Bold" FontSize="12" Foreground="#C084FC"/>
                                        <TextBlock Text="Siber Mor &amp; Neon Işıltı" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- OLED Deep Black -->
                                <Border x:Name="CardThemeOledBlack" Style="{StaticResource ThemePreviewCardStyle}" Tag="OledBlack" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#040406" BorderBrush="#44FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#22C55E" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#26FFFFFF" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#EAB308"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="⬛ OLED Deep Black" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Saf Siyah Kontrast" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Saydam Floating -->
                                <Border x:Name="CardThemeTransparent" Style="{StaticResource ThemePreviewCardStyle}" Tag="Transparent" MouseLeftButtonDown="ThemeCard_Click">
                                    <StackPanel>
                                        <Border Height="42" CornerRadius="10" Background="#22000000" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,0,8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#38BDF8" Margin="0,0,5,0"/>
                                                <Border Width="28" Height="12" CornerRadius="4" Background="#22FFFFFF" Margin="0,0,5,0"/>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="#F43F5E"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="🪟 Saydam (Floating)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Çerçevesiz Havada Duran" FontSize="10" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Geriye Dönük Uyumluluk için Gizli ComboBox -->
                            <ComboBox x:Name="CmbStyle" Visibility="Collapsed" SelectionChanged="CmbStyle_SelectionChanged">
                                <ComboBoxItem Content="DarkGlass" Tag="DarkGlass" IsSelected="True"/>
                                <ComboBoxItem Content="LiquidGlass" Tag="LiquidGlass"/>
                                <ComboBoxItem Content="LightGlass" Tag="LightGlass"/>
                                <ComboBoxItem Content="Cyberpunk" Tag="Cyberpunk"/>
                                <ComboBoxItem Content="OledBlack" Tag="OledBlack"/>
                                <ComboBoxItem Content="Transparent" Tag="Transparent"/>
                            </ComboBox>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="🔍 Dock Ölçeği (Büyütme / Küçültme)" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="#2538BDF8" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtScaleVal" Text="1.00x" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DockPanel>
                                    <Slider x:Name="SldScale" Minimum="0.8" Maximum="1.25" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SldScale_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="↔️ Widget Kartları Arası Boşluk (Spacing)" FontWeight="SemiBold" FontSize="13"/>
                                        <Border Background="#2510B981" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtSpacingVal" Text="8 px" Foreground="#34D399" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                    </DockPanel>
                                    <Slider x:Name="SldSpacing" Minimum="2" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldSpacing_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource SettingCardStyle}" Margin="0,0,6,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Saydamlığı Azalt" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="Mat ve yüksek kontrastlı yüzey" FontSize="10.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkReduceTransparency" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ChkReduceTransparency_Click"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingCardStyle}" Margin="6,0,0,10">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Widget Kart Çerçeveleri" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="Her widget etrafında cam sınır" FontSize="10.5" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkTileBorders" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ChkReduceTransparency_Click"/>
                                    </DockPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 1.5 ÖZEL WIDGET'LARIM (LIVING ISLAND & SUPER TILE YÖNETİCİSİ) -->
                        <StackPanel x:Name="PanelCustomWidgets" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="✨ + Yeni Özel Widget Oluştur" Padding="14,7" Background="#38BDF8"
                                        Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnOpenWidgetStudio_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="✨ Özel Widget'larım (Living Island &amp; Super Tile)" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Oluşturduğunuz widget'ları buradan tek tıkla düzenleyebilir, boyutlandırabilir veya kaldırabilirsiniz." FontSize="11.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel x:Name="SpSettingsCustomWidgetsList"/>
                        </StackPanel>

                        <!-- 2. DÜZEN VE SENARYOLAR -->
                        <StackPanel x:Name="PanelLayout" Visibility="Collapsed">
                            <TextBlock Text="📐 Ekran Konumu &amp; Yerleşim Senaryoları" FontSize="19" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Dock'un ekranın hangi kenarında ve hizasında duracağını seçin." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Ekran Kenarı (Dikey Konum)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Alt (Görev Çubuğu Üstü) veya Üst (Ekran Tavanı)." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbPosition" Width="175" DockPanel.Dock="Right" VerticalAlignment="Center" SelectionChanged="CmbPosition_SelectionChanged">
                                        <ComboBoxItem Content="⬇️ Alt (Görev Çubuğu Üstü)" Tag="Bottom" IsSelected="True"/>
                                        <ComboBoxItem Content="⬆️ Üst (Ekran Üstü)" Tag="Top"/>
                                    </ComboBox>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Yatay Hizalama" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Ortalı, Sola Yaslı veya Sağa Yaslı." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbAlignment" Width="175" DockPanel.Dock="Right" VerticalAlignment="Center" SelectionChanged="CmbAlignment_SelectionChanged">
                                        <ComboBoxItem Content="⏺️ Ortalı (Center)" Tag="Center" IsSelected="True"/>
                                        <ComboBoxItem Content="⬅️ Sola Yaslı (Left)" Tag="Left"/>
                                        <ComboBoxItem Content="➡️ Sağa Yaslı (Right)" Tag="Right"/>
                                    </ComboBox>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Yerleşim Davranışı (Senaryo)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="OxiDock pencere etkileşim modu." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbScenario" Width="175" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <ComboBoxItem Content="☁️ Yüzen (Floating)" Tag="Floating" IsSelected="True"/>
                                        <ComboBoxItem Content="📌 Sabit (Fixed)" Tag="Fixed"/>
                                        <ComboBoxItem Content="🔄 Altta Yer Değiştir (Swap)" Tag="Swap"/>
                                        <ComboBoxItem Content="✨ Kenarda Belir (Reveal)" Tag="Reveal"/>
                                    </ComboBox>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3. GENEL AYARLAR -->
                        <StackPanel x:Name="PanelGeneral" Visibility="Collapsed">
                            <TextBlock Text="⚙️ Genel Tercihler &amp; Hava Durumu" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="📌 Her Zaman Üstte Tut (Always on Top)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Dock'un diğer masaüstü pencerelerinin üzerinde kalmasını sağlar." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAlwaysOnTop" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="👻 Otomatik Gizle (Auto-Hide)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Fare dock üzerinden ayrıldığında saydamlaşır." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoHide" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="🎮 Tam Ekran Oyun ve Videolarda Gizle" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Tam ekran uygulama algılandığında odak bozulmaması için gizlenir." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkFullscreenHide" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="🏝️ Dinamik Ada (Dynamic Island) Bildirim Kapsülü" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Medya, ses, kopyalama veya AI etkileşimlerinde dock üstünde akıcı ada genişlemesi." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkDynamicIsland" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="📁 OxiShelf Geçici Dosya Rafı (Dropzone Shelf)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Dosyaları dock'a sürükleyip geçici olarak rafta bekletin ve uygulamalara taşıyın." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkFileShelf" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="🌤️ Canlı Hava Durumu Şehri" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Open-Meteo üzerinden anlık sıcaklık ve yarın tahmini çekilecek şehir." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtWeatherCity" Text="İstanbul" Width="140" DockPanel.Dock="Right" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="8,5"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- 4. PROFİLLER (PROFILES) -->
                        <StackPanel x:Name="PanelProfiles" Visibility="Collapsed">
                            <TextBlock Text="🗂️ Çalışma Alanları (Profiller)" FontSize="19" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Her çalışma alanı kendi widget dizilimini, boyutlarını ve özel widget'larını bağımsız saklar." FontSize="11.5" Foreground="#94A3B8" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Aktif Çalışma Alanı" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Şu anda Dock üzerinde gösterilen profil." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbActiveProfile" Width="180" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Kayıtlı Çalışma Alanları" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left"/>
                                        <TextBlock Text="Seçip yeniden adlandırabilir veya silebilirsiniz" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <ListBox x:Name="LstProfiles" Height="130" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" SelectionChanged="LstProfiles_SelectionChanged"/>
                                    <DockPanel Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBox x:Name="TxtNewProfileName" Width="150" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="7,5" Margin="0,0,8,0" ToolTip="Çalışma Alanı Adı"/>
                                            <Button Content="➕ Yeni Ekle" Padding="12,5" Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAddProfile_Click"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Button x:Name="BtnRenameProfile" Content="✏️ Adı Güncelle" Padding="10,5" Background="#22FFFFFF" Foreground="#FFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF" Cursor="Hand" Margin="0,0,6,0" Click="BtnRenameProfile_Click"/>
                                            <Button x:Name="BtnDeleteProfile" Content="🗑️ Alanı Sil" Padding="10,5" Background="#33EF4444" Foreground="#F87171" BorderThickness="1" BorderBrush="#55EF4444" Cursor="Hand" Click="BtnDeleteProfile_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 5. POMODORO & SAĞLIK (WELLNESS) -->
                        <StackPanel x:Name="PanelPomodoro" Visibility="Collapsed">
                            <TextBlock Text="🍅 Pomodoro Odaklanma &amp; Wellness" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Odaklanma Süresi (Dakika)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Standart Pomodoro odak turu süresi (Varsayılan: 25 dk)." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtPomoFocus" Text="25" Width="70" DockPanel.Dock="Right" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="8,5"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Kısa Mola Süresi (Dakika)" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Her odak turu sonrası dinlenme süresi (Varsayılan: 5 dk)." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtPomoBreak" Text="5" Width="70" DockPanel.Dock="Right" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#475569" Padding="8,5"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="💧 Duruş (Posture) &amp; Su Hatırlatıcıları" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Mola başlangıçlarında masa başı sağlık bildirimi gösterir." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkReminders" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- 6. AI ASİSTAN (MCP SERVER) -->
                        <StackPanel x:Name="PanelAi" Visibility="Collapsed">
                            <TextBlock Text="🤖 Yerel AI Asistan Entegrasyonu (MCP)" FontSize="19" FontWeight="Bold" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Yerel AI Sunucusunu Etkinleştir" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Antigravity, Claude, Cursor ve yerel betiklerin Dock ile konuşmasını sağlar." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableAi" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Yerel MCP &amp; REST Uç Noktası" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="http://127.0.0.1:48199/api/status  •  http://127.0.0.1:48199/mcp" Foreground="#38BDF8" FontFamily="Consolas" Margin="0,5,0,3"/>
                                    <TextBlock Text="Araçlar: inspect_dock, switch_profile, toggle_widget, control_pomodoro" FontSize="11" Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCardStyle}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="AI'ın Profil ve Widget Değiştirmesine İzin Ver" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="AI istemcisi üzerinden gelen canlı düzenleme komutlarını uygular." FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAllowAiChanges" IsChecked="True" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
