<Window x:Class="OxiDock.WidgetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OxiDock Widget Kütüphanesi" Height="600" Width="840"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <!-- Kategori Filtre Buton Stili -->
        <Style x:Key="CategoryTabStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3338BDF8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5538BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Android Boyut Hapı (Pill) Stili -->
        <Style x:Key="SizePillStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Widget Kartı Stili -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#161622"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Width" Value="252"/>
            <Setter Property="Height" Value="122"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E1E30"/>
                    <Setter Property="BorderBrush" Value="#7738BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Ana Çerçeve (Koyu Glass & Canlı Kenarlık) -->
    <Border Background="#F70E0E17" CornerRadius="20" BorderBrush="#3338BDF8" BorderThickness="1.2" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.88"/>
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Üst Başlık Barı (Sürüklenebilir) -->
                <RowDefinition Height="Auto"/> <!-- Kategori Filtre Butonları -->
                <RowDefinition Height="*"/>    <!-- Kaydırılabilir Kartlar Alanı -->
            </Grid.RowDefinitions>

            <!-- 1. Üst Başlık ve Kapatma Butonu (Pencereyi Taşımak İçin Sürüklenebilir) -->
            <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Window_Header_MouseDown" Margin="2,0,2,6">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Background="#1FFFFFFF" 
                            Foreground="#AAFFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click" HorizontalAlignment="Right">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OxiDock Widget Kütüphanesi" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                                <Border Background="#2538BDF8" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="Android Boyutlandırmalı (1x1, 1x2, 1x3)" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Widget kartlarını açın, Android boyutlarını seçin veya doğrudan Dock'a sürükleyin" 
                                       FontSize="11" Foreground="#88FFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Kategori Filtre Sekmeleri -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,4,2,8">
                <Button x:Name="BtnCatAll" Content="🌟 Tümü (15)" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="all"/>
                <Button x:Name="BtnCatTime" Content="⏰ Zaman &amp; Odak" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="time"/>
                <Button x:Name="BtnCatSystem" Content="📊 Sistem &amp; Ağ" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="system"/>
                <Button x:Name="BtnCatWeb" Content="🌐 Web &amp; Finans" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="web"/>
                <Button x:Name="BtnCatShortcuts" Content="⚡ Kısayollar &amp; Pano" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="shortcuts"/>
            </StackPanel>

            <!-- 3. Kaydırılabilir Widget Kartları Listesi -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                <WrapPanel x:Name="PnlWidgetList" Orientation="Horizontal">

                    <!-- 1. Saat & Takvim -->
                    <Border x:Name="CardClock" Style="{StaticResource WidgetCardStyle}" Tag="clock"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Üst Başlık -->
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#2238BDF8" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="⏰" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeClock" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusClock" Text="✓ Aktif" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Saat &amp; Zaman" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Dijital, Retro, Dünya" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Görsel Dock Önizleme -->
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="⏰ 10:45:20 • 26 Eki Pzt" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Android Boyut Hapları -->
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnClock1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x1"/>
                                    <Button x:Name="BtnClock1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x2"/>
                                    <Button x:Name="BtnClock1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Pomodoro Odak -->
                    <Border x:Name="CardPomodoro" Style="{StaticResource WidgetCardStyle}" Tag="pomodoro"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#26EF4444" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="🍅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgePomodoro" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusPomodoro" Text="✓ Aktif" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pomodoro &amp; Odak" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="25-5 Döngüsü &amp; İlerleme" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="🍅 25:00 ODAK [● ○ ○ ○]" FontSize="10" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnPomodoro1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x1"/>
                                    <Button x:Name="BtnPomodoro1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x2"/>
                                    <Button x:Name="BtnPomodoro1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Hava Durumu -->
                    <Border x:Name="CardWeather" Style="{StaticResource WidgetCardStyle}" Tag="weather"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#22F59E0B" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="☀️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeWeather" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusWeather" Text="✓ Aktif" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hava Durumu" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Canlı Derece &amp; 5 Günlük" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="☀️ 22° Kozan | Yarın 24°" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnWeather1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x1"/>
                                    <Button x:Name="BtnWeather1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x2"/>
                                    <Button x:Name="BtnWeather1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Donanım & Sistem Monitörü -->
                    <Border x:Name="CardSystem" Style="{StaticResource WidgetCardStyle}" Tag="system"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#223B82F6" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="⚡" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeSystem" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusSystem" Text="✓ Aktif" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Donanım Monitörü" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="CPU, RAM, Disk, Ağ" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="CPU 14% | RAM 46% | Disk C:" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnSystem1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x1"/>
                                    <Button x:Name="BtnSystem1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x2"/>
                                    <Button x:Name="BtnSystem1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Kripto & Piyasa Kurları (YENİ WEB WIDGET) -->
                    <Border x:Name="CardCrypto" Style="{StaticResource WidgetCardStyle}" Tag="crypto"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#26F59E0B" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="₿" FontSize="13" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeCrypto" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusCrypto" Text="+ Ekle" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kripto &amp; Piyasa" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="BTC, ETH, SOL, USD/TRY" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="BTC $68,450 | ETH $2,640" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnCrypto1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x1"/>
                                    <Button x:Name="BtnCrypto1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x2"/>
                                    <Button x:Name="BtnCrypto1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 6. Takvim & Ajanda (YENİ WIDGET) -->
                    <Border x:Name="CardCalendar" Style="{StaticResource WidgetCardStyle}" Tag="calendar"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#22EC4899" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="📅" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeCalendar" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusCalendar" Text="+ Ekle" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Takvim &amp; Ajanda" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Günlük Plan &amp; Hafta" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="📅 26 Ekim Pazartesi" FontSize="10" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnCalendar1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="calendar:1x1"/>
                                    <Button x:Name="BtnCalendar1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="calendar:1x2"/>
                                    <Button x:Name="BtnCalendar1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="calendar:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 7. Spotlight Hızlı Web/AI Arama (YENİ WEB WIDGET) -->
                    <Border x:Name="CardQuickSearch" Style="{StaticResource WidgetCardStyle}" Tag="quicksearch"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#228B5CF6" Margin="0,0,6,0" DockPanel.Dock="Left">
                                    <TextBlock Text="🔍" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeQuickSearch" DockPanel.Dock="Right" CornerRadius="8" Padding="6,1" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusQuickSearch" Text="+ Ekle" FontSize="9" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Spotlight Arama" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Google, Perplexity, ChatGPT" FontSize="8" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <Border Grid.Row="1" Background="#0C1424" CornerRadius="6" Margin="0,4,0,4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="[ 🔍 Web / Yapay Zeka Ara ]" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnQuickSearch1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="quicksearch:1x1"/>
                                    <Button x:Name="BtnQuickSearch1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="quicksearch:1x2"/>
                                    <Button x:Name="BtnQuickSearch1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="quicksearch:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 8. Medya & Spotify Çalar -->
                    <Border x:Name="CardMusic" Style="{StaticResource WidgetCardStyle}" Tag="music"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="24" Height="24" CornerRadius="6" Background="#2222C55E" Margin="0,0,6,0" DockPanel.Dock="Left">
