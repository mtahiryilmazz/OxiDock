<Window x:Class="OxiDock.WidgetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OxiDock Widget Kütüphanesi" Height="680" Width="1020"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Inter">

    <Window.Resources>
        <!-- Kategori Filtre Buton Stili -->
        <Style x:Key="CategoryTabStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3338BDF8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6638BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Android Boyut Hapı (Pill) Stili -->
        <Style x:Key="SizePillStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 & CoolDock Tarzı Zengin Widget Kart Stili -->
        <Style x:Key="WidgetCardStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#241B1B2A" Offset="0.0"/>
                        <GradientStop Color="#2013131E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="6,6"/>
            <Setter Property="Height" Value="156"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3526263D" Offset="0.0"/>
                                <GradientStop Color="#2D1B1B2C" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#8838BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kart İçi Önizleme Konteyner Stili -->
        <Style x:Key="CardPreviewContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="#D90A0D14"/>
            <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Ana Çerçeve (Koyu Glass & Canlı Kenarlık) -->
    <Border Background="#F90D0E16" CornerRadius="24" BorderBrush="#3838BDF8" BorderThickness="1.2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.92"/>
        </Border.Effect>

        <Grid Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Üst Başlık Barı (Sürüklenebilir) -->
                <RowDefinition Height="Auto"/> <!-- Kategori Filtre Butonları -->
                <RowDefinition Height="*"/>    <!-- 3 Sütunlu Kaydırılabilir Kartlar Alanı -->
            </Grid.RowDefinitions>

            <!-- 1. Üst Başlık ve Kapatma Butonu (Pencereyi Taşımak İçin Sürüklenebilir) -->
            <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Window_Header_MouseDown" Margin="2,0,2,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="✨ + Kendi Widget'ını Oluştur" Padding="12,6" Background="#2638BDF8" 
                                Foreground="#38BDF8" BorderBrush="#5538BDF8" BorderThickness="1.2" FontWeight="Bold" FontSize="11" 
                                Cursor="Hand" Margin="0,0,10,0" Click="BtnCreateCustomWidget_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="9"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="✕" Width="30" Height="30" Background="#1FFFFFFF" 
                                Foreground="#AAFFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#2638BDF8" Margin="0,0,10,0">
                            <TextBlock Text="🧩" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OxiDock Widget Kütüphanesi" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                                <Border Background="#2538BDF8" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                                    <TextBlock Text="Windows &amp; CoolDock 3x Sütun" FontSize="10" Foreground="#38BDF8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Önizlemeli widget kartlarını keşfedin, Android 1x1, 1x2, 1x3 boyutlarını seçin veya Dock'a sürükleyin" 
                                       FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Kategori Filtre Sekmeleri -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,12">
                <Button x:Name="BtnCatAll" Content="🌟 Tümü (15)" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="all"/>
                <Button x:Name="BtnCatTime" Content="⏰ Zaman &amp; Odak" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="time"/>
                <Button x:Name="BtnCatSystem" Content="📊 Sistem &amp; Ağ" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="system"/>
                <Button x:Name="BtnCatWeb" Content="🌐 Web &amp; Finans" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="web"/>
                <Button x:Name="BtnCatShortcuts" Content="⚡ Kısayollar &amp; Pano" Style="{StaticResource CategoryTabStyle}" Click="BtnCategory_Click" Tag="shortcuts"/>
            </StackPanel>

            <!-- 3. 3 Sütunlu Kaydırılabilir Widget Kartları Listesi -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                <UniformGrid x:Name="PnlWidgetList" Columns="3">

                    <!-- 1. Saat & Takvim -->
                    <Border x:Name="CardClock" Style="{StaticResource WidgetCardStyle}" Tag="clock"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Üst Başlık -->
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#2638BDF8" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="⏰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeClock" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusClock" Text="✓ Aktif" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Saat &amp; Zaman" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Dijital, Retro, Dünya Saatleri" FontSize="9" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Windows / CoolDock Görsel Canlı Önizleme -->
                            <Border Grid.Row="1" Style="{StaticResource CardPreviewContainerStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#1A38BDF8" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,4,0">
                                        <TextBlock Text="10:45" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Segoe UI, Consolas"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="26 Eki Pazartesi" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="IST (UTC+3) • CANLI" FontSize="8" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Android Boyut Hapları -->
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnClock1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x1"/>
                                    <Button x:Name="BtnClock1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x2"/>
                                    <Button x:Name="BtnClock1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="clock:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 2. Pomodoro Odak -->
                    <Border x:Name="CardPomodoro" Style="{StaticResource WidgetCardStyle}" Tag="pomodoro"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#26EF4444" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="🍅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgePomodoro" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusPomodoro" Text="✓ Aktif" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pomodoro &amp; Odak" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="25-5 Döngüsü &amp; İlerleme" FontSize="9" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Canlı Önizleme -->
                            <Border Grid.Row="1" Style="{StaticResource CardPreviewContainerStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#26EF4444" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="25:00" FontSize="13" FontWeight="Bold" Foreground="#F87171" FontFamily="Segoe UI, Consolas"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ODAKLANMA DÖNGÜSÜ" FontSize="8" FontWeight="Bold" Foreground="#EF4444"/>
                                        <TextBlock Text="● ○ ○ ○ (Tur 1/4)" FontSize="9" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnPomodoro1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x1"/>
                                    <Button x:Name="BtnPomodoro1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x2"/>
                                    <Button x:Name="BtnPomodoro1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="pomodoro:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Hava Durumu -->
                    <Border x:Name="CardWeather" Style="{StaticResource WidgetCardStyle}" Tag="weather"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#26F59E0B" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="☀️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeWeather" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusWeather" Text="✓ Aktif" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hava Durumu" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Canlı Derece &amp; 5 Günlük" FontSize="9" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Canlı Önizleme -->
                            <Border Grid.Row="1" Style="{StaticResource CardPreviewContainerStyle}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="☀️ 22°" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Kozan • Parçalı Bulutlu" FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Sal 20° • Çar 17° • Per 21°" FontSize="8" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnWeather1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x1"/>
                                    <Button x:Name="BtnWeather1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x2"/>
                                    <Button x:Name="BtnWeather1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="weather:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Donanım & Sistem Monitörü -->
                    <Border x:Name="CardSystem" Style="{StaticResource WidgetCardStyle}" Tag="system"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#263B82F6" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="⚡" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeSystem" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusSystem" Text="✓ Aktif" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Donanım Monitörü" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="CPU, RAM, Disk, Pil" FontSize="9" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Canlı Önizleme -->
                            <Border Grid.Row="1" Style="{StaticResource CardPreviewContainerStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="CPU 14%" FontSize="9" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <ProgressBar Value="14" Maximum="100" Height="3" Width="36" Foreground="#3B82F6" Background="#22FFFFFF" BorderThickness="0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="RAM 46%" FontSize="9" FontWeight="Bold" Foreground="#C084FC"/>
                                        <ProgressBar Value="46" Maximum="100" Height="3" Width="36" Foreground="#A855F7" Background="#22FFFFFF" BorderThickness="0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="⚡ 92%" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                        <TextBlock Text="PİL DOLU" FontSize="7" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnSystem1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x1"/>
                                    <Button x:Name="BtnSystem1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x2"/>
                                    <Button x:Name="BtnSystem1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="system:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 5. Kripto & Piyasa Kurları -->
                    <Border x:Name="CardCrypto" Style="{StaticResource WidgetCardStyle}" Tag="crypto"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#26F59E0B" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="₿" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BadgeCrypto" DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" Background="#2034D399" BorderBrush="#4034D399" BorderThickness="1">
                                    <TextBlock x:Name="TxtStatusCrypto" Text="+ Ekle" FontSize="10" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kripto &amp; Piyasa" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                    <TextBlock Text="BTC, ETH, SOL, USD/TRY" FontSize="9" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Canlı Önizleme -->
                            <Border Grid.Row="1" Style="{StaticResource CardPreviewContainerStyle}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="BTC" FontSize="8" FontWeight="Bold" Foreground="#F59E0B"/>
                                        <TextBlock Text="$68,450" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#22FFFFFF" Margin="3,0"/>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="ETH" FontSize="8" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <TextBlock Text="$2,640" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <Border Width="1" Height="16" Background="#22FFFFFF" Margin="3,0"/>
                                    <StackPanel Margin="4,0">
                                        <TextBlock Text="USD" FontSize="8" FontWeight="Bold" Foreground="#34D399"/>
                                        <TextBlock Text="34.25 ₺" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock Text="Boyut:" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button x:Name="BtnCrypto1x1" Content="1x1" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x1"/>
                                    <Button x:Name="BtnCrypto1x2" Content="1x2" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x2"/>
                                    <Button x:Name="BtnCrypto1x3" Content="1x3" Style="{StaticResource SizePillStyle}" Click="BtnWidgetSize_Click" Tag="crypto:1x3"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- 6. Takvim & Ajanda -->
                    <Border x:Name="CardCalendar" Style="{StaticResource WidgetCardStyle}" Tag="calendar"
                            PreviewMouseLeftButtonDown="WidgetCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="WidgetCard_PreviewMouseMove"
                            MouseLeftButtonUp="WidgetCard_MouseLeftButtonUp">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#26EC4899" Margin="0,0,8,0" DockPanel.Dock="Left">
                                    <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
